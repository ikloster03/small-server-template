# Переменные окружения сервера.
# Скопируйте файл: cp .env.example .env
# Bun подхватывает .env автоматически при локальном запуске.

# Порт HTTP-сервера (по умолчанию 3000).
PORT=3000

# Путь к файлу SQLite. Docker-контейнер использует /data/app.db (том).
# Для локальной разработки укажите путь в проекте, например ./data/app.db.
DATABASE_PATH=./data/app.db

# Уровень логирования pino: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info

# Отключить проверку bearer-токенов: true | false.
# Только для локальной разработки — в проде держите false.
AUTH_DISABLED=false
