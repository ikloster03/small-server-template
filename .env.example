# Переменные окружения сервера.
# Скопируйте файл: cp .env.example .env

# Порт HTTP-сервера (по умолчанию 3000).
PORT=3000

# URL подключения к PostgreSQL (postgres:// или postgresql://).
# Вариант с локальной БД (docker-compose.yml) собирает URL сам из POSTGRES_* ниже.
# Для compose.external-db.yml укажите здесь адрес внешней БД.
DATABASE_URL=postgres://app:app@localhost:5432/app

# Уровень логирования pino: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info

# Отключить проверку bearer-токенов: true | false.
# Только для локальной разработки — в проде держите false.
AUTH_DISABLED=false

# --- Переменные локальной Postgres (использует docker-compose.yml) ---

# Пользователь, пароль и имя базы локальной Postgres.
# Пароль обязательно смените перед реальным использованием.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
